/-
Extends Verso's built-in bibliography system (`VersoManual.Bibliography`, which
only covers `Thesis`/`InProceedings`/`ArXiv`/`Article`) with a catch-all `Misc`
entry kind for books, websites, online courses, and other sources that don't
fit those four types. Mirrors the pattern of `VersoManual.Bibliography` closely
so that `citetOther`/`citepOther`/`citehereOther` behave exactly like the
built-in `citet`/`citep`/`citehere`.

Generated text (the "and"/"y" between authors and the "Last accessed"/"Última
consulta" note) is localized through the `docs.bib.lang` option: each document
file elaborates its citations with the language that is set at that point, so
Spanish chapters use `"es"` (the default) and English chapters must declare

  set_option docs.bib.lang "en"

before their `#doc` block.
-/
import VersoManual
import VersoManual.Bibliography

open Lean Elab
open Verso Doc Elab Html
open Verso Output Html
open Verso Genre Manual
open Verso ArgParse

register_option docs.bib.lang : String := {
  defValue := "es"
  descr := "Language for text generated by the bibliography machinery (\"es\" or \"en\")"
}

namespace Verso.Genre.Manual.Docs

abbrev Style := Verso.Genre.Manual.Bibliography.Style
abbrev lastName := Verso.Genre.Manual.Bibliography.Bibliography.lastName

/-- The word placed between the last two items of an author list. -/
private def andWord (lang : String) : String :=
  if lang == "en" then "and" else "y"

private def andSep (lang : String) : String :=
  " " ++ andWord lang ++ " "

/-- A calendar date for "last accessed" notes, rendered per language. -/
structure AccessDate where
  day : Nat
  month : Nat
  year : Nat
deriving ToJson, FromJson, BEq, Hashable, Ord

private def monthNameEs : Nat → String
  | 1 => "enero" | 2 => "febrero" | 3 => "marzo" | 4 => "abril"
  | 5 => "mayo" | 6 => "junio" | 7 => "julio" | 8 => "agosto"
  | 9 => "septiembre" | 10 => "octubre" | 11 => "noviembre" | 12 => "diciembre"
  | _ => ""

private def monthNameEn : Nat → String
  | 1 => "January" | 2 => "February" | 3 => "March" | 4 => "April"
  | 5 => "May" | 6 => "June" | 7 => "July" | 8 => "August"
  | 9 => "September" | 10 => "October" | 11 => "November" | 12 => "December"
  | _ => ""

def AccessDate.text (lang : String) (d : AccessDate) : String :=
  if lang == "en" then
    s!"Last accessed: {monthNameEn d.month} {d.day}, {d.year}."
  else
    s!"Última consulta: {d.day} de {monthNameEs d.month} de {d.year}."

structure Misc where
  title : Doc.Inline Manual
  authors : Array (Doc.Inline Manual)
  year : Option Int := none
  note : Doc.Inline Manual
  url : Option String := none
  accessed : Option AccessDate := none
deriving ToJson, FromJson, BEq, Hashable, Ord

private def andList (lang : String) (xs : Array Html) : Html :=
  if h : xs.size = 0 then panic! "tried to construct empty list of authors"
  else if h : xs.size = 1 then xs[0]
  else if h : xs.size = 2 then xs[0] ++ andSep lang ++ xs[1]
  else
    open Html in
    (xs.extract 0 (xs.size - 1)).foldr (init := {{ {{andWord lang}} " " {{xs.back}} }}) (· ++ ", " ++ ·)

def Misc.bibHtml [Monad m]
    (go : Doc.Inline Genre.Manual → HtmlT Manual m Html) (lang : String) (c : Misc) : HtmlT Manual m Html :=
  wrap <$> open Html in do
    let authors ← andList lang <$> c.authors.mapM go
    let yearPart := c.year.map (s!", {·}. ") |>.getD ". "
    let accessedPart : Html := c.accessed.map (fun d => {{" " {{d.text lang}} }}) |>.getD .empty
    return {{ {{authors}} {{yearPart}} {{ link {{"“" {{← go c.title}} "”"}} }} ". " {{← go c.note}} {{accessedPart}} }}
where
  wrap (content : Html) : Html := {{<span class="citation">{{content}}</span>}}
  link (title : Html) : Html :=
    match c.url with
    | .none => title
    | .some u => {{<a href={{u}}>{{title}}</a>}}

def Misc.inlineHtml [Monad m]
    (go : Doc.Inline Genre.Manual → HtmlT Manual m Html)
    (ps : List Misc)
    (fmt : Style)
    (lang : String) :
    HtmlT Manual m Html := open Html in do
  match fmt with
  | .textual =>
    let out : Array Html ← ps.toArray.mapM fun p => do
      let m ← p.bibHtml go lang
      let yearPart := p.year.map (s!" ({·})") |>.getD ""
      pure <| {{ {{← authorHtml p}} {{yearPart}} }} ++ Marginalia.html m
    pure <| andList lang out
  | .parenthetical =>
    let out : Array Html ← ps.toArray.mapM fun p => do
      let m ← p.bibHtml go lang
      let yearPart := p.year.map (s!", {·})") |>.getD ")"
      pure <| {{" (" {{← authorHtml p}} {{yearPart}} }} ++ Marginalia.html m
    pure <| andList lang out
  | .here => do
    pure <| andList lang (← ps.toArray.mapM (·.bibHtml go lang))
where
  authorHtml p := open Html in do
    if p.authors.size = 0 then
      pure {{""}}
    else if h : p.authors.size = 1 then
      go p.authors[0]
    else if h : p.authors.size > 3 then
      (· ++ {{" "<em>"et al."</em>}}) <$> go p.authors[0]
    else andList lang <$> p.authors.mapM go

open Verso.Doc.TeX in
def Misc.bibTeX
    (go : Doc.Inline Genre.Manual → TeXT Manual (ReaderT ExtensionImpls IO) Output.TeX)
    (lang : String) (c : Misc) :
    TeXT Manual (ReaderT ExtensionImpls IO) Output.TeX := open Output.TeX in do
  let authors ← andListTeX <$> c.authors.mapM go
  let link (title : Output.TeX) : Output.TeX :=
    match c.url with
    | .none => title
    | .some u => makeLink u title
  let yearPart := c.year.map (s!", {·}. ") |>.getD ". "
  let accessedPart : Output.TeX := c.accessed.map (fun d => \TeX{ " " \Lean{d.text lang} }) |>.getD .empty
  return \TeX{
    \Lean{authors} \Lean{yearPart}
    \Lean{ link \TeX{ "``" \Lean{← go c.title} "''" } } ". "
    \Lean{← go c.note} \Lean{accessedPart}
  }
where
  andListTeX (xs : Array Output.TeX) : Output.TeX :=
    if h : xs.size = 0 then panic! "tried to construct empty list of authors"
    else if h : xs.size = 1 then xs[0]
    else if h : xs.size = 2 then xs[0] ++ andSep lang ++ xs[1]
    else
      open Output.TeX in
      (xs.extract 0 (xs.size - 1)).foldr (init := \TeX{\Lean{andSep lang} \Lean{xs.back} }) (· ++ ", " ++ ·)

open Verso.Doc.TeX in
def Misc.inlineTeX
    (go : Doc.Inline Genre.Manual → TeXT Manual (ReaderT ExtensionImpls IO) Output.TeX)
    (ps : List Misc)
    (fmt : Style)
    (lang : String) :
    TeXT Manual (ReaderT ExtensionImpls IO) Output.TeX := open Output.TeX in do
  match fmt with
  | .textual =>
    let out : Array Output.TeX ← ps.toArray.mapM fun p => do
      let m ← p.bibTeX go lang
      let yearPart := p.year.map (s!" ({·})") |>.getD ""
      pure <| \TeX{ \Lean{← authorTeX p} \Lean{yearPart} \Lean{Marginalia.TeX m} }
    pure <| andListTeX out
  | .parenthetical =>
    let out : Array Output.TeX ← ps.toArray.mapM fun p => do
      let m ← p.bibTeX go lang
      let yearPart := p.year.map (s!", {·})") |>.getD ")"
      pure <| \TeX{ "(" \Lean{← authorTeX p} \Lean{yearPart} " " \Lean{Marginalia.TeX m} }
    pure <| andListTeX out
  | .here => do
    pure <| andListTeX (← ps.toArray.mapM (·.bibTeX go lang))
where
  andListTeX (xs : Array Output.TeX) : Output.TeX :=
    if h : xs.size = 0 then panic! "tried to construct empty list of authors"
    else if h : xs.size = 1 then xs[0]
    else if h : xs.size = 2 then xs[0] ++ andSep lang ++ xs[1]
    else
      open Output.TeX in
      (xs.extract 0 (xs.size - 1)).foldr (init := \TeX{\Lean{andSep lang} \Lean{xs.back} }) (· ++ ", " ++ ·)
  authorTeX p := open Output.TeX in do
    if p.authors.size = 0 then
      pure .empty
    else if h : p.authors.size = 1 then
      go p.authors[0]
    else if h : p.authors.size > 3 then
      (· ++ \TeX{" " \em{"et al."} }) <$> go p.authors[0]
    else andListTeX <$> p.authors.mapM go

inline_extension Inline.citeMisc (citations : List Misc) (style : Style := .parenthetical) (lang : String := "es") where
  data := ToJson.toJson (citations, style, lang)
  traverse _ _ _ := pure none
  toHtml :=
    open Verso.Output.Html in
    some <| fun go _ data _content => do
      match FromJson.fromJson? data with
      | .error e => HtmlT.logError s!"Failed to deserialize citation: {e}"; return {{""}}
      | .ok ((v, style, lang) : List Misc × Style × String) =>
        Misc.inlineHtml go v style lang
  toTeX :=
    open Verso.Output.TeX in
    some <| fun go _ data _content => do
      match FromJson.fromJson? data with
      | .error e => TeX.logError s!"Failed to deserialize citation: {e}"; return .empty
      | .ok ((v, style, lang) : List Misc × Style × String) =>
        Misc.inlineTeX go v style lang
  extraCss := [Marginalia.css]

structure CiteConfig where
  citations : List Name

section
variable [Monad m] [MonadInfoTree m] [MonadLiftT CoreM m] [MonadEnv m] [MonadError m] [MonadFileMap m]

partial def CiteConfig.parse : ArgParse m CiteConfig :=
  CiteConfig.mk <$> many1 (.positional `citation .resolvedName)
where
  many1 p := (· :: ·) <$> p <*> .many p

instance : FromArgs CiteConfig m where
  fromArgs := CiteConfig.parse
end

@[role]
def citetOther : RoleExpanderOf CiteConfig
  | config, extra => do
    let lang := docs.bib.lang.get (← getOptions)
    let xs := config.citations.map mkIdent |>.toArray
    ``(Doc.Inline.other (Inline.citeMisc ([$xs,*] : List Misc) Verso.Genre.Manual.Bibliography.Style.textual $(quote lang)) #[$(← extra.mapM elabInline),*])

@[role]
def citepOther : RoleExpanderOf CiteConfig
  | config, extra => do
    let lang := docs.bib.lang.get (← getOptions)
    let xs := config.citations.map mkIdent |>.toArray
    ``(Doc.Inline.other (Inline.citeMisc ([$xs,*] : List Misc) Verso.Genre.Manual.Bibliography.Style.parenthetical $(quote lang)) #[$(← extra.mapM elabInline),*])

@[role]
def citehereOther : RoleExpanderOf CiteConfig
  | config, extra => do
    let lang := docs.bib.lang.get (← getOptions)
    let xs := config.citations.map mkIdent |>.toArray
    ``(Doc.Inline.other (Inline.citeMisc ([$xs,*] : List Misc) Verso.Genre.Manual.Bibliography.Style.here $(quote lang)) #[$(← extra.mapM elabInline),*])

end Verso.Genre.Manual.Docs
